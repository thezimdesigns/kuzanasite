# KUZANA SCEEZ: environment variables.
# Production: set these in Coolify → your Docker Compose resource → Environment Variables.
# Never commit real values. Generate secrets with:  openssl rand -hex 32

# --- Site ---------------------------------------------------------------
# Public URL (canonical). Also used for auth callbacks and share links. Build-time.
NEXT_PUBLIC_SITE_URL=https://www.kuzana.org.zw

# --- Database (PostgreSQL in the compose stack) --------------------------
# openssl rand -hex 24
POSTGRES_PASSWORD=
# Only for running the app outside Docker:
DATABASE_URL=postgresql://kuzana:kuzana@localhost:5440/kuzana

# --- Staff authentication (Better Auth) ----------------------------------
# openssl rand -hex 32
BETTER_AUTH_SECRET=
# First super admin, created once by the migrate job. Remove the password after first deploy.
SEED_ADMIN_EMAIL=
# at least 10 characters
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=KUZANA Admin

# --- Object storage (Garage, S3-compatible) -----------------------------
# openssl rand -hex 32
GARAGE_RPC_SECRET=
# openssl rand -hex 32
GARAGE_ADMIN_TOKEN=
# space Garage may use on the server disk
GARAGE_CAPACITY=100G
S3_BUCKET=kuzana-media
# "GK" + 24 hex chars:  echo GK$(openssl rand -hex 12)
S3_ACCESS_KEY_ID=
# openssl rand -hex 32
S3_SECRET_ACCESS_KEY=
# Local development without Docker can write uploads to ./.uploads instead:
# STORAGE_DRIVER=local

# --- Exhibitor registration (unlisted; shared by QR code) -------------------
# The public form only opens with ?code=<this value>. Print QR codes from Admin → QR codes.
# e.g. a random 8-character code
EXHIBITOR_ACCESS_CODE=

# --- Spam protection (reCAPTCHA v3; reuse the existing KUZANA keys) ---------
# Off by default. Set to true (and fill both keys) to protect every public form.
# Read at runtime: change it in Coolify and restart, no rebuild needed.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# --- Web Push (browser notifications) -----------------------------------
# Generate once:  npx web-push generate-vapid-keys
# build-time
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:technical-partner@kuzana.org.zw

# --- Email (Amazon SES API; af-south-1 has no SMTP) ------------------------
AWS_REGION=af-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=updates@kuzana.org.zw
SES_FROM_NAME=KUZANA SCEEZ
SES_REPLY_TO_EMAIL=technical-partner@kuzana.org.zw
# Delay between emails in ms. Sandbox allows 1/s → use 1100. Production default 14/s → 120.
SES_SEND_INTERVAL_MS=1100
