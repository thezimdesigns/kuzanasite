generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  PROGRAMME_EDITOR
  MEDIA_EDITOR
  PRESS_OFFICER
  EXHIBITOR_MANAGER
  FEEDBACK_MANAGER
  VIEWER
}

enum PublishStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ProgrammeStatus {
  UPCOMING
  STARTING_SOON
  LIVE
  COMPLETED
  POSTPONED
  CANCELLED
  VENUE_CHANGED
}

enum SessionType {
  REGISTRATION
  OPENING_CEREMONY
  KEYNOTE
  PRESENTATION
  PANEL_DISCUSSION
  WORKSHOP
  QA
  NETWORKING
  CULTURAL_PERFORMANCE
  BREAK
  LUNCH
  CLOSING_SESSION
  OTHER
}

enum ParticipantRole {
  SPEAKER
  PANELLIST
  MODERATOR
  FACILITATOR
  GUEST_OF_HONOUR
  PERFORMER
  ARTIST
  ATHLETE
}

enum ExhibitorStatus {
  PENDING
  APPROVED
  REJECTED
  NEEDS_INFORMATION
}

enum ExhibitorSource {
  PUBLIC
  STAFF
}

enum ExhibitorMediaKind {
  LOGO
  BOOTH
  FLYER
  BROCHURE
  BUSINESS_CARD
  PRODUCT
  TEAM
  OTHER
}

enum AnnouncementPriority {
  INFO
  IMPORTANT
  URGENT
}

enum FeedbackStatus {
  NEW
  UNDER_REVIEW
  ASSIGNED
  RESOLVED
  ARCHIVED
}

enum DocumentType {
  PRESS_RELEASE
  SPEECH
  PRESENTATION
  REPORT
  PRESS_KIT
  BRAND_ASSET
  PROGRAMME
  OTHER
}

enum VideoCategory {
  HIGHLIGHTS
  INTERVIEWS
  SPEECHES
  CONFERENCE_SESSIONS
  PERFORMANCES
  SPORT
  BEHIND_THE_SCENES
  PROMOTIONAL
}

enum PartnerTier {
  HOST
  PARTNER
  SPONSOR
  MEDIA
  SUPPORTER
}

enum MessageStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PARTIALLY_FAILED
  FAILED
  CANCELLED
}

enum Channel {
  WEB_PUSH
  EMAIL
}

// ---------------------------------------------------------------------------
// Auth (Better Auth)
// ---------------------------------------------------------------------------

model User {
  id            String        @id
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  role          Role          @default(VIEWER)
  active        Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  sessions      AuthSession[]
  accounts      Account[]

  @@map("user")
}

model AuthSession {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ---------------------------------------------------------------------------
// Editions, venues, programme
// ---------------------------------------------------------------------------

model Edition {
  id          String   @id @default(cuid())
  year        Int      @unique
  name        String
  theme       String?
  description String?
  startDate   DateTime
  endDate     DateTime
  isCurrent   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events        Event[]
  exhibitors    Exhibitor[]
  albums        PhotoAlbum[]
  videos        Video[]
  documents     Document[]
  announcements Announcement[]
  partners      Partner[]
}

model Venue {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  description   String?
  address       String?
  latitude      Float?
  longitude     Float?
  mapUrl        String?
  directions    String?
  parking       String?
  accessibility String?
  openingTimes  String?
  contact       String?
  imageKey      String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  events   Event[]
  feedback Feedback[]
}

model EventCategory {
  id        String  @id @default(cuid())
  name      String  @unique
  slug      String  @unique
  sortOrder Int     @default(0)
  events    Event[]
}

model Event {
  id                   String           @id @default(cuid())
  editionId            String
  edition              Edition          @relation(fields: [editionId], references: [id])
  categoryId           String?
  category             EventCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  venueId              String?
  venue                Venue?           @relation(fields: [venueId], references: [id], onDelete: SetNull)
  title                String
  slug                 String           @unique
  summary              String?
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  timeTbc              Boolean          @default(false)
  room                 String?
  posterKey            String?
  imageKey             String?
  ticketRequired       Boolean          @default(false)
  ticketPrice          String?
  ticketUrl            String?
  registrationRequired Boolean          @default(false)
  registrationUrl      String?
  contact              String?
  isConference         Boolean          @default(false)
  statusOverride       ProgrammeStatus?
  statusNote           String?
  featured             Boolean          @default(false)
  publishStatus        PublishStatus    @default(DRAFT)
  sortOrder            Int              @default(0)
  createdById          String?
  updatedById          String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  sessions      Session[]
  participants  EventParticipant[]
  albums        PhotoAlbum[]
  videos        Video[]
  documents     Document[]
  announcements Announcement[]
  feedback      Feedback[]
  ratings       Rating[]
  subscriptions EventSubscription[]
  messages      Message[]

  @@index([startsAt])
  @@index([publishStatus, startsAt])
  @@index([editionId])
}

model Session {
  id             String           @id @default(cuid())
  eventId        String
  event          Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  startsAt       DateTime
  endsAt         DateTime?
  room           String?
  type           SessionType      @default(OTHER)
  statusOverride ProgrammeStatus?
  publishStatus  PublishStatus    @default(PUBLISHED)
  sortOrder      Int              @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  participants SessionParticipant[]
  documents    Document[]
  videos       Video[]
  ratings      Rating[]

  @@index([eventId, startsAt])
}

model Person {
  id            String        @id @default(cuid())
  name          String
  slug          String        @unique
  photoKey      String?
  jobTitle      String?
  organisation  String?
  bio           String?
  country       String?
  website       String?
  linkedin      String?
  twitter       String?
  instagram     String?
  publishStatus PublishStatus @default(PUBLISHED)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  eventRoles   EventParticipant[]
  sessionRoles SessionParticipant[]

  @@index([name])
}

model EventParticipant {
  id        String          @id @default(cuid())
  eventId   String
  event     Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId  String
  person    Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      ParticipantRole @default(SPEAKER)
  sortOrder Int             @default(0)

  @@unique([eventId, personId, role])
}

model SessionParticipant {
  id        String          @id @default(cuid())
  sessionId String
  session   Session         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  personId  String
  person    Person          @relation(fields: [personId], references: [id], onDelete: Cascade)
  role      ParticipantRole @default(SPEAKER)
  sortOrder Int             @default(0)

  @@unique([sessionId, personId, role])
}

model Announcement {
  id            String               @id @default(cuid())
  editionId     String?
  edition       Edition?             @relation(fields: [editionId], references: [id], onDelete: SetNull)
  eventId       String?
  event         Event?               @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title         String
  body          String?
  linkUrl       String?
  priority      AnnouncementPriority @default(INFO)
  publishStatus PublishStatus        @default(PUBLISHED)
  expiresAt     DateTime?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([publishStatus, priority])
}

// ---------------------------------------------------------------------------
// Exhibitors
// ---------------------------------------------------------------------------

model ExhibitorCategory {
  id         String      @id @default(cuid())
  name       String      @unique
  slug       String      @unique
  sortOrder  Int         @default(0)
  exhibitors Exhibitor[]
}

model Exhibitor {
  id            String             @id @default(cuid())
  editionId     String
  edition       Edition            @relation(fields: [editionId], references: [id])
  categoryId    String?
  category      ExhibitorCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name          String
  slug          String             @unique
  contactName   String
  phone         String
  email         String?
  hall          String?
  stand         String?
  description   String?
  showcasing    String?
  products      String?
  website       String?
  facebook      String?
  instagram     String?
  linkedin      String?
  tiktok        String?
  whatsapp      String?
  address       String?
  opportunities String[]           @default([])
  seeking       String?
  offering      String?
  consent       Boolean            @default(false)
  consentAt     DateTime?
  status        ExhibitorStatus    @default(PENDING)
  source        ExhibitorSource    @default(PUBLIC)
  reviewNotes   String?
  logoKey       String?
  createdById   String?
  updatedById   String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  media       ExhibitorMedia[]
  claimTokens ExhibitorClaimToken[]

  @@index([status, name])
  @@index([categoryId])
  @@index([editionId])
}

model ExhibitorMedia {
  id          String             @id @default(cuid())
  exhibitorId String
  exhibitor   Exhibitor          @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  kind        ExhibitorMediaKind
  key         String
  fileName    String?
  mimeType    String
  size        Int
  width       Int?
  height      Int?
  caption     String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())

  @@index([exhibitorId])
}

model ExhibitorClaimToken {
  id          String    @id @default(cuid())
  exhibitorId String
  exhibitor   Exhibitor @relation(fields: [exhibitorId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Media
// ---------------------------------------------------------------------------

model PhotoAlbum {
  id            String        @id @default(cuid())
  editionId     String
  edition       Edition       @relation(fields: [editionId], references: [id])
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  title         String
  slug          String        @unique
  description   String?
  date          DateTime?
  photographer  String?
  coverKey      String?
  sortOrder     Int           @default(0)
  publishStatus PublishStatus @default(DRAFT)
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  photos        Photo[]

  @@index([publishStatus, date])
}

model Photo {
  id        String     @id @default(cuid())
  albumId   String
  album     PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)
  key       String
  width     Int?
  height    Int?
  size      Int?
  caption   String?
  sortOrder Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([albumId, sortOrder])
}

model Video {
  id            String        @id @default(cuid())
  editionId     String
  edition       Edition       @relation(fields: [editionId], references: [id])
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sessionId     String?
  session       Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  title         String
  youtubeId     String
  description   String?
  date          DateTime?
  category      VideoCategory @default(HIGHLIGHTS)
  featured      Boolean       @default(false)
  publishStatus PublishStatus @default(PUBLISHED)
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([publishStatus, date])
}

model Document {
  id            String        @id @default(cuid())
  editionId     String
  edition       Edition       @relation(fields: [editionId], references: [id])
  eventId       String?
  event         Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  sessionId     String?
  session       Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  title         String
  slug          String        @unique
  description   String?
  body          String?
  type          DocumentType  @default(OTHER)
  key           String?
  fileName      String?
  mimeType      String?
  size          Int?
  date          DateTime?
  author        String?
  publishStatus PublishStatus @default(PUBLISHED)
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type, publishStatus, date])
}

model Partner {
  id        String      @id @default(cuid())
  editionId String?
  edition   Edition?    @relation(fields: [editionId], references: [id], onDelete: SetNull)
  name      String
  logoKey   String?
  logoUrl   String?
  url       String?
  tier      PartnerTier @default(PARTNER)
  caption   String?
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

// Editable content pages (Plan Your Visit, Privacy, ...). Body is Markdown.
model Page {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String?
  body        String
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model Feedback {
  id                String         @id @default(cuid())
  name              String?
  email             String?
  phone             String?
  category          String
  eventId           String?
  event             Event?         @relation(fields: [eventId], references: [id], onDelete: SetNull)
  venueId           String?
  venue             Venue?         @relation(fields: [venueId], references: [id], onDelete: SetNull)
  rating            Int?
  message           String
  contactPermission Boolean        @default(false)
  anonymous         Boolean        @default(false)
  status            FeedbackStatus @default(NEW)
  adminNotes        String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([status, createdAt])
}

model Rating {
  id        String   @id @default(cuid())
  eventId   String?
  event     Event?   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sessionId String?
  session   Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  stars     Int
  comment   String?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([sessionId])
}

model InterestRegistration {
  id           String   @id @default(cuid())
  name         String
  organisation String?
  email        String?
  phone        String?
  country      String?
  interest     String
  message      String?
  consent      Boolean  @default(false)
  source       String   @default("website")
  createdAt    DateTime @default(now())

  @@index([interest])
}

model Visitor {
  id               String   @id @default(cuid())
  name             String
  phone            String?
  email            String?
  organisation     String?
  city             String?
  country          String?
  ageRange         String?
  visitorType      String?
  interests        String[] @default([])
  emailConsent     Boolean  @default(false)
  pushConsent      Boolean  @default(false)
  unsubscribeToken String   @unique @default(cuid())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  pushSubscriptions PushSubscription[]
  subscriptions     EventSubscription[]
  checkIns          EventCheckIn[]

  @@index([email])
  @@index([phone])
}

model PushSubscription {
  id                   String    @id @default(cuid())
  visitorId            String?
  visitor              Visitor?  @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  endpoint             String    @unique
  p256dh               String
  auth                 String
  userAgent            String?
  active               Boolean   @default(true)
  failureCount         Int       @default(0)
  lastSuccessfulSendAt DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  eventSubscriptions EventSubscription[]

  @@index([active])
}

// "Notify me" for an event: linked to a visitor (email) and/or a push subscription.
model EventSubscription {
  id                 String            @id @default(cuid())
  eventId            String
  event              Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  visitorId          String?
  visitor            Visitor?          @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  pushSubscriptionId String?
  pushSubscription   PushSubscription? @relation(fields: [pushSubscriptionId], references: [id], onDelete: Cascade)
  createdAt          DateTime          @default(now())

  @@unique([eventId, pushSubscriptionId])
  @@unique([eventId, visitorId])
}

model EventCheckIn {
  id        String   @id @default(cuid())
  visitorId String?
  visitor   Visitor? @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  eventId   String?
  name      String?
  phone     String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model Message {
  id             String        @id @default(cuid())
  title          String
  body           String
  url            String?
  audience       String
  channels       Channel[]
  eventId        String?
  event          Event?        @relation(fields: [eventId], references: [id], onDelete: SetNull)
  status         MessageStatus @default(DRAFT)
  recipientCount Int           @default(0)
  sentCount      Int           @default(0)
  failedCount    Int           @default(0)
  sentAt         DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

// Fixed-window counter for public form rate limiting.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}
